<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
    <!-- The substitution task is loaded by MSBuild in a real build; here it is exercised
         directly, so the test host supplies the same MSBuild assemblies its host would. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.10.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NuGetToCompLog\NuGetToCompLog.csproj" />
    <ProjectReference Include="..\..\src\NuGetToCompLog.SourceBuild\NuGetToCompLog.SourceBuild.csproj" />
  </ItemGroup>

</Project>
